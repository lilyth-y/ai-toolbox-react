# Environment Variables Template
# 실제 사용 시 이 파일을 복사하여 .env 파일을 만들고, 실제 값으로 교체하세요.
# cp .env.example .env

# Google Analytics 4 Measurement ID
# https://analytics.google.com/ 에서 발급
VITE_GA4_ID=G-XXXXXXXXXX

# Google AdSense Publisher ID
# https://adsense.google.com/ 에서 발급
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXX

# AdSense 광고 슬롯 IDs
VITE_AD_SLOT_HOME_TOP=XXXXXXXXXX
VITE_AD_SLOT_HOME_BOTTOM=XXXXXXXXXX
VITE_AD_SLOT_TOOL_INFEED=XXXXXXXXXX

# Site Configuration
VITE_SITE_TITLE=AI Toolbox
VITE_SITE_URL=https://yourdomain.com

# Contact Email
VITE_CONTACT_EMAIL=contact@yourdomain.com

# Gemini API Proxy URL (Firebase Cloud Functions)
# https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/geminiProxy
VITE_GEMINI_PROXY_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/geminiProxy
